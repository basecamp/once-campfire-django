#!/bin/sh
set -eu
if [ "${WEB_WORKERS:-1}" -gt 1 ] && [ -z "${REDIS_URL:-}" ]; then
  echo "REDIS_URL is required for multiple workers" >&2
  exit 1
fi
python manage.py prepare
exec uvicorn campfire.asgi:application --host "${BIND:-0.0.0.0}" --port "${HTTP_PORT:-8080}" --workers "${WEB_WORKERS:-1}" --no-access-log --proxy-headers --forwarded-allow-ips "${TRUSTED_PROXIES:-127.0.0.1}"
